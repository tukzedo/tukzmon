## tukzmon settings, read by the panel plugin and by tukzmon-settings.
##
## Compiled into both. The format is knobs', documented in knobs/src/lib.rs
## and SilkTerm's knobs/demo/demo.shcl. Colors default to b23's, which started
## as a customized multiload-ng setup.
##
## slider_range is ours, not knobs'. It's how far a slider reaches, while
## range is what can be typed in the box beside it. shown_as: radio draws a
## dropdown as radio buttons, and shown_when: "id = key" shows a row only
## while that dropdown is on that key. Those 2 are ours too.
##
## A graph's row in the Graphs list comes from its show, width, sample_ms and
## time settings, in that order.
##
## Every color is in the theme group, and so are each graph's mode and the
## margins. A row's default is the Default theme's value, and config::tests
## holds the two to each other.

tabs: "Graph", "Themes", "Themes/CPU", "Themes/Memory", "Themes/Network", "Themes/Disk", "Themes/Temperature", "Themes/Swap", "Themes/Zswap", "Themes/Load", "Themes/Battery", "Themes/tukzmon", "Themes/Outline"

settings:

	SizeHead:
		label: Size
		tab: Graph
		control: heading

	width:
		label: Width px
		tab: Graph
		control: slider
		whole: true
		range: 16, 4096
		slider_range: 24, 1024
		scale: log
		path: graph.width
		default: 128
		detents: 64, 128, 256
		tip: "How wide a graph is in the panel at 100%. Each graph under Graphs takes a percentage of it. Its height follows the panel.\n\nOn a vertical panel or a deskbar, this is how tall a graph is, and its width follows the panel. Time still runs from left to right."

	TimeHead:
		label: Time
		tab: Graph
		control: heading

	time_axis:
		label: Time axis default
		tab: Graph
		control: dropdown
		options: linear, smooth, fixed_a, fixed_b
		option_labels: "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: graph.time
		default: smooth
		tip: "How a graph spreads time across its width, unless it picks its own under Graphs. Linear is a plain scrolling graph. The log curves squeeze older history to the left, so the last minute and the last day fit in one graph.\n\nSmooth log is one log curve across the whole run, with each pixel covering a little more time than the one to its right.\n\nLog A and Log B split the graph into 4 fixed divisions. From the right, they cover at most the last minute, the next 59 minutes, the next 23 hours, and everything older. Log A fills them early: the first after about half an hour of history, and all 3 within a week. Log B follows Smooth log until a division fills, after about a day and a half for the first and 4 months for all 3."

	sample_ms:
		label: Sample ms default
		tab: Graph
		control: slider
		whole: true
		range: 50, 60000
		slider_range: 100, 5000
		scale: log
		path: graph.sample_ms
		default: 500
		detents: 250, 500, 1000, 2000
		tip: "How often a graph is read and redrawn, in ms, unless it has its own rate under Graphs."

	spikes:
		label: Spike emphasis %
		tab: Graph
		control: slider
		whole: true
		range: 0, 100
		path: graph.spikes
		default: 50
		tip: "How far a squeezed column reaches from its average toward its peak. At 0% every column shows only its average, so short spikes in older history are smoothed away. At 100% a column covering a few seconds shows its full peak. The reach fades as a column covers more time, so on the far left spikes melt into the background even at 100%."

	hover_time:
		label: Hover shows
		tab: Graph
		control: dropdown
		options: ago, clock
		option_labels: "How long ago", "Date and time"
		path: graph.hover_time
		default: ago
		tip: "What the tip says about the time under the pointer. How long ago reads like 7 hrs ago. Date and time gives just the time for today, and the date too for anything older, in your locale's short format."

	LookHead:
		label: Frame
		tab: Graph
		control: heading

	border:
		label: Border px
		tab: Graph
		control: slider
		whole: true
		range: 0, 16
		slider_range: 0, 4
		path: graph.border
		default: 1

	GraphsHead:
		label: Graphs
		tab: Graph
		control: heading

	show_cpu:
		label: CPU
		tab: Graph
		control: checkbox
		path: cpu.show
		default: true
		tip: "Show CPU use: I/O wait, system, user and nice, from the bottom up. With every other graph off, it shows anyway, so the panel item never goes away."

	cpu_width:
		label: CPU width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: cpu.width
		default: 100
		tip: "How wide the CPU graph is, or how tall on a vertical panel, as a percentage of Width."

	cpu_sample_ms:
		label: CPU sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: cpu.sample_ms
		default: 0
		tip: "How often the CPU graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	cpu_time:
		label: CPU time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: cpu.time
		default: same
		tip: "How the CPU graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_memory:
		label: Memory
		tab: Graph
		control: checkbox
		path: mem.show
		default: true
		tip: "Show memory use beside the CPU graph: what programs use, then buffers, then cache, from the bottom up. It's left out on a box where memory can't be read."

	mem_width:
		label: Memory width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: mem.width
		default: 100
		tip: "How wide the memory graph is, or how tall on a vertical panel, as a percentage of Width."

	mem_sample_ms:
		label: Memory sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: mem.sample_ms
		default: 0
		tip: "How often the memory graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	mem_time:
		label: Memory time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: mem.time
		default: same
		tip: "How the memory graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_net:
		label: Network
		tab: Graph
		control: checkbox
		path: net.show
		default: false
		tip: "Show network traffic in bytes a second: local, which is the box talking to itself, then sent, then received, from the bottom up. The top follows the busiest moment in view, so the graph has no fixed scale. The tip gives the rates."

	net_width:
		label: Network width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: net.width
		default: 50
		tip: "How wide the network graph is, or how tall on a vertical panel, as a percentage of Width."

	net_sample_ms:
		label: Network sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: net.sample_ms
		default: 0
		tip: "How often the network graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	net_time:
		label: Network time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: net.time
		default: same
		tip: "How the network graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_disk:
		label: Disk
		tab: Graph
		control: checkbox
		path: disk.show
		default: false
		tip: "Show disk traffic in bytes a second: written, then read, from the bottom up. The top follows the busiest moment in view, so the graph has no fixed scale. The tip gives the rates. Disk drives and Disk log scale, further down, set what it counts and how it's drawn."

	disk_width:
		label: Disk width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: disk.width
		default: 50
		tip: "How wide the disk graph is, or how tall on a vertical panel, as a percentage of Width."

	disk_sample_ms:
		label: Disk sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: disk.sample_ms
		default: 0
		tip: "How often the disk graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	disk_time:
		label: Disk time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: disk.time
		default: same
		tip: "How the disk graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_temp:
		label: Temperature
		tab: Graph
		control: checkbox
		path: temp.show
		default: false
		tip: "Show the CPU's temperature. It fills to the top at the sensor's critical level, or 95 degrees C when the sensor gives none, and anything over that is drawn on top in the critical color. It's left out on a box with no CPU sensor it knows."

	temp_width:
		label: Temperature width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: temp.width
		default: 50
		tip: "How wide the temperature graph is, or how tall on a vertical panel, as a percentage of Width."

	temp_sample_ms:
		label: Temperature sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: temp.sample_ms
		default: 0
		tip: "How often the temperature graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	temp_time:
		label: Temperature time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: temp.time
		default: same
		tip: "How the temperature graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_swap:
		label: Swap
		tab: Graph
		control: checkbox
		path: swap.show
		default: true
		tip: "Show how much swap is in use. It's left out on a box with no swap."

	swap_width:
		label: Swap width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: swap.width
		default: 25
		tip: "How wide the swap graph is, or how tall on a vertical panel, as a percentage of Width."

	swap_sample_ms:
		label: Swap sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: swap.sample_ms
		default: 0
		tip: "How often the swap graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	swap_time:
		label: Swap time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: swap.time
		default: same
		tip: "How the swap graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_zswap:
		label: Zswap
		tab: Graph
		control: checkbox
		path: zswap.show
		default: false
		tip: "Show how full the compressed swap pool is, zswap's or else zram's, with how far it squeezes what it holds written over it, such as 2.1x. It's left out on a box with neither."

	zswap_width:
		label: Zswap width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: zswap.width
		default: 25
		tip: "How wide the zswap graph is, or how tall on a vertical panel, as a percentage of Width."

	zswap_sample_ms:
		label: Zswap sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: zswap.sample_ms
		default: 0
		tip: "How often the zswap graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	zswap_time:
		label: Zswap time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: zswap.time
		default: same
		tip: "How the zswap graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_load:
		label: Load
		tab: Graph
		control: checkbox
		path: load.show
		default: false
		tip: "Show the 1 minute load average, the number of tasks running or waiting to run. The top follows the highest load in view, but never goes under the number of CPUs, so a full graph means every CPU had work queued."

	load_width:
		label: Load width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: load.width
		default: 25
		tip: "How wide the load graph is, or how tall on a vertical panel, as a percentage of Width."

	load_sample_ms:
		label: Load sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: load.sample_ms
		default: 0
		tip: "How often the load graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	load_time:
		label: Load time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: load.time
		default: same
		tip: "How the load graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_battery:
		label: Battery
		tab: Graph
		control: checkbox
		path: battery.show
		default: false
		tip: "Show the battery's charge, in one color while plugged in, another on battery, and a third once it's critical. It's left out on a box with no battery in."

	battery_width:
		label: Battery width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: battery.width
		default: 100
		tip: "How wide the battery graph is, or how tall on a vertical panel, as a percentage of Width."

	battery_sample_ms:
		label: Battery sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: battery.sample_ms
		default: 0
		tip: "How often the battery graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	battery_time:
		label: Battery time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: battery.time
		default: same
		tip: "How the battery graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	show_self:
		label: tukzmon
		tab: Graph
		control: checkbox
		path: self.show
		default: false
		tip: "Show how much of all the CPUs' time tukzmon itself takes. The graph is full when every CPU is busy, as the CPU graph is, so its usual small share is a thin line. The tip has the number. On Wayland tukzmon runs inside the panel, so this is the whole panel's use, and the tip says so."

	self_width:
		label: tukzmon width %
		tab: Graph
		control: number
		whole: true
		range: 1, 1000
		path: self.width
		default: 25
		tip: "How wide the tukzmon graph is, or how tall on a vertical panel, as a percentage of Width."

	self_sample_ms:
		label: tukzmon sample ms
		tab: Graph
		control: number
		whole: true
		range: 0, 60000
		path: self.sample_ms
		default: 0
		tip: "How often the tukzmon graph is read and redrawn, in ms. Default, which is 0, follows Sample ms default, under Time. Under 50 counts as 50."

	self_time:
		label: tukzmon time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "Default", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: self.time
		default: same
		tip: "How the tukzmon graph spreads time across its width. Default follows Time axis default, under Time, where the tip tells the curves apart."

	## The graph list's grippers write this, and it has no row of its own.
	graph_order:
		label: Order
		tab: Graph
		control: text
		path: graph.order
		default: "cpu mem net disk temp swap zswap load battery self"
		tip: "The graphs from left to right, or top to bottom on a vertical panel, by name: cpu for CPU, mem for memory, net for network, swap, zswap, load, disk, temp for temperature, battery, and self for tukzmon itself. One left out goes at the end."

	DiskHead:
		label: Disk graph
		tab: Graph
		control: heading

	disk_drives:
		label: Disk drives
		tab: Graph
		control: text
		path: disk.drives
		default: all
		gate: show_disk
		tip: "Which drives the disk graph counts: all, or names as /proc/diskstats gives them, such as sda nvme0n1. All is every disk with hardware behind it, and leaves out partitions and what sits on a disk, such as LUKS, LVM and RAID, so nothing is counted twice. A named drive is counted as is, partitions too."

	disk_log:
		label: Disk log scale
		tab: Graph
		control: checkbox
		path: disk.log
		default: false
		gate: show_disk
		tip: "Draw the disk graph on a log scale, so a trickle still shows next to a big copy. Off, the height is in proportion to the rate."

	HistoryHead:
		label: History
		tab: Graph
		control: heading

	keep_history:
		label: Keep across restarts
		tab: Graph
		control: checkbox
		path: history.keep
		default: true
		tip: "Save the graph's history and load it back when the panel starts, with the time it wasn't running left as a gap. Off stops saving, but what's already saved is kept for when it's turned back on."

	max_days:
		label: Max age in days
		tab: Graph
		control: number
		whole: true
		range: 1, 36500
		path: history.max_days
		default: 365
		gate: keep_history
		tip: "History older than this is dropped."

	theme:
		label: Name
		tab: Themes
		control: dropdown
		path: theme.name
		default: default
		tip: "A set of colors for every graph and its background. A color changed below is kept on top of the theme, and the theme's name gets a * after it. Save as keeps the colors as a theme of your own."

	cpu_mode:
		label: Colors
		tab: Themes/CPU
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: cpu.mode
		default: detailed
		group: theme
		tip: "Detailed gives each kind of CPU time a color of its own. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

	CpuHead:
		label: "CPU, from the bottom up"
		tab: Themes/CPU
		control: heading
		shown_when: "cpu_mode = detailed"

	iowait:
		label: I/O wait
		tab: Themes/CPU
		control: color
		path: cpu.colors.iowait
		default: "#ff0000"
		group: theme
		shown_when: "cpu_mode = detailed"

	system:
		label: System
		tab: Themes/CPU
		control: color
		path: cpu.colors.system
		default: "#fa72f0"
		group: theme
		shown_when: "cpu_mode = detailed"
		tip: "Kernel time, including interrupts."

	user:
		label: User
		tab: Themes/CPU
		control: color
		path: cpu.colors.user
		default: "#00ff80"
		group: theme
		shown_when: "cpu_mode = detailed"

	nice:
		label: Nice
		tab: Themes/CPU
		control: color
		path: cpu.colors.nice
		default: "#205f40"
		group: theme
		shown_when: "cpu_mode = detailed"
		tip: "Programs running at a lower priority."

	CpuGradHead:
		label: "CPU, by height"
		tab: Themes/CPU
		control: heading
		shown_when: "cpu_mode = gradient"

	cpu_low:
		label: Low
		tab: Themes/CPU
		control: color
		path: cpu.colors.low
		default: "#205f40"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color at the bottom of the graph. A column blends smoothly from Low through Medium to High as it climbs."

	cpu_medium:
		label: Medium
		tab: Themes/CPU
		control: color
		path: cpu.colors.medium
		default: "#00ff80"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color halfway up."

	cpu_high:
		label: High
		tab: Themes/CPU
		control: color
		path: cpu.colors.high
		default: "#c0ffe0"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color at the top."

	mem_mode:
		label: Colors
		tab: Themes/Memory
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: mem.mode
		default: detailed
		group: theme
		tip: "Detailed gives programs, buffers and cache a color each. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

	MemHead:
		label: "Memory, from the bottom up"
		tab: Themes/Memory
		control: heading
		shown_when: "mem_mode = detailed"

	mem_user:
		label: Programs
		tab: Themes/Memory
		control: color
		path: mem.colors.user
		default: "#ffffa3"
		group: theme
		shown_when: "mem_mode = detailed"
		tip: "Memory in use that isn't buffers or cache."

	mem_buffers:
		label: Buffers
		tab: Themes/Memory
		control: color
		path: mem.colors.buffers
		default: "#804080"
		group: theme
		shown_when: "mem_mode = detailed"

	mem_cache:
		label: Cache
		tab: Themes/Memory
		control: color
		path: mem.colors.cache
		default: "#408060"
		group: theme
		shown_when: "mem_mode = detailed"
		tip: "The page cache, which the kernel gives back when programs need it."

	MemGradHead:
		label: "Memory, by height"
		tab: Themes/Memory
		control: heading
		shown_when: "mem_mode = gradient"

	mem_low:
		label: Low
		tab: Themes/Memory
		control: color
		path: mem.colors.low
		default: "#408060"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color at the bottom of the graph. A column blends smoothly from Low through Medium to High as it climbs."

	mem_medium:
		label: Medium
		tab: Themes/Memory
		control: color
		path: mem.colors.medium
		default: "#ffffa3"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color halfway up."

	mem_high:
		label: High
		tab: Themes/Memory
		control: color
		path: mem.colors.high
		default: "#ffffe0"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color at the top."

	net_mode:
		label: Colors
		tab: Themes/Network
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: net.mode
		default: detailed
		group: theme
		tip: "Detailed gives local, sent and received a color each. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

