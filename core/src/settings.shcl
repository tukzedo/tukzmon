## tukzmon settings, read by the panel plugin and by tukzmon-settings.
##
## Compiled into both. The format is knobs', documented in knobs/src/lib.rs
## and SilkTerm's knobs/demo/demo.shcl. Colors default to a customized
## multiload-ng setup.
##
## slider_range is ours, not knobs'. It's how far a slider reaches, while
## range is what can be typed in the box beside it.

tabs: "Graph", "Colors"

settings:

	SizeHead:
		label: Size
		tab: Graph
		control: heading

	width:
		label: Width px
		tab: Graph
		control: slider
		whole: true
		range: 16, 4096
		slider_range: 24, 1024
		scale: log
		path: graph.width
		default: 128
		detents: 64, 128, 256
		tip: "How wide the graph is in the panel. Its height follows the panel."

	TimeHead:
		label: Time
		tab: Graph
		control: heading

	log_axis:
		label: Log time axis
		tab: Graph
		control: checkbox
		path: graph.log_axis
		default: true
		tip: "Squeeze older history to the left, so the last minute and the last day fit in one graph. Off gives a plain scrolling graph."

	log_curve:
		label: Log curve
		tab: Graph
		control: dropdown
		options: smooth, fixed_a, fixed_b
		option_labels: "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: graph.log_curve
		default: smooth
		gate: log_axis
		tip: "How older history is squeezed. Smooth log is one log curve across the whole run, with each pixel covering a little more time than the one to its right.\n\nLog A and Log B split the graph into 4 fixed divisions. From the right, they cover at most the last minute, the next 59 minutes, the next 23 hours, and everything older. Log A fills them early: the first after about half an hour of history, and all 3 within a week. Log B follows Smooth log until a division fills, after about a day and a half for the first and 4 months for all 3."

	sample_ms:
		label: Sample every ms
		tab: Graph
		control: slider
		whole: true
		range: 50, 60000
		slider_range: 100, 5000
		scale: log
		path: graph.sample_ms
		default: 500
		detents: 250, 500, 1000, 2000
		tip: "How often the CPU is read and the graph redrawn."

	spikes:
		label: Spike emphasis %
		tab: Graph
		control: slider
		whole: true
		range: 0, 100
		path: graph.spikes
		default: 50
		gate: log_axis
		tip: "How far a squeezed column reaches from its average toward its peak. At 0% every column shows only its average, so short spikes in older history are smoothed away. At 100% a column covering a few seconds shows its full peak. The reach fades as a column covers more time, so on the far left spikes melt into the background even at 100%."

	hover_time:
		label: Hover shows
		tab: Graph
		control: dropdown
		options: ago, clock
		option_labels: "How long ago", "Date and time"
		path: graph.hover_time
		default: ago
		tip: "What the tip says about the time under the pointer. How long ago reads like 7 hrs ago. Date and time gives just the time for today, and the date too for anything older, in your locale's short format."

	LookHead:
		label: Frame
		tab: Graph
		control: heading

	border:
		label: Border px
		tab: Graph
		control: slider
		whole: true
		range: 0, 16
		slider_range: 0, 4
		path: graph.border
		default: 1

	HistoryHead:
		label: History
		tab: Graph
		control: heading

	keep_history:
		label: Keep across restarts
		tab: Graph
		control: checkbox
		path: history.keep
		default: true
		tip: "Save the graph's history and load it back when the panel starts, with the time it wasn't running left as a gap. Off stops saving, but what's already saved is kept for when it's turned back on."

	max_days:
		label: Max age in days
		tab: Graph
		control: number
		whole: true
		range: 1, 36500
		path: history.max_days
		default: 365
		gate: keep_history
		tip: "History older than this is dropped."

	CpuHead:
		label: "CPU, from the bottom up"
		tab: Colors
		control: heading

	iowait:
		label: I/O wait
		tab: Colors
		control: color
		path: cpu.colors.iowait
		default: "#ff0000"

	system:
		label: System
		tab: Colors
		control: color
		path: cpu.colors.system
		default: "#c64600"
		tip: "Kernel time, including interrupts."

	user:
		label: User
		tab: Colors
		control: color
		path: cpu.colors.user
		default: "#00ff80"

	nice:
		label: Nice
		tab: Colors
		control: color
		path: cpu.colors.nice
		default: "#205f40"
		tip: "Programs running at a lower priority."

	BackHead:
		label: Background
		tab: Colors
		control: heading

	border_color:
		label: Border
		tab: Colors
		control: color
		path: graph.colors.border
		default: "#40806a"

	back_top:
		label: Top
		tab: Colors
		control: color
		path: graph.colors.top
		default: "#2a5446"

	back_bottom:
		label: Bottom
		tab: Colors
		control: color
		path: graph.colors.bottom
		default: "#000000"

	hover_color:
		label: Hover line
		tab: Colors
		control: color
		path: graph.colors.hover
		default: "#000000"
		tip: "The line under the pointer."
