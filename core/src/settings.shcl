		label: High
		tab: Themes/tukzmon
		control: color
		path: self.colors.high
		default: "#cffffa"
		group: theme
		shown_when: "self_mode = gradient"
		tip: "The color at the top."

	MarginHead:
		label: Margins
		tab: Themes/Outline
		control: heading

	margin_tb:
		label: Top & bottom px
		tab: Themes/Outline
		control: slider
		whole: true
		range: 0, 64
		slider_range: 0, 8
		path: graph.margins.top_bottom
		default: 2
		group: theme
		tip: "Space left clear above and below each graph, so the panel shows through. On a vertical panel the graphs are stacked, so this is the space between 2 of them, from each. The top and bottom of the whole item get none there, since the panel spaces its items."

	margin_lr:
		label: Left & right px
		tab: Themes/Outline
		control: slider
		whole: true
		range: 0, 64
		slider_range: 0, 8
		path: graph.margins.left_right
		default: 2
		group: theme
		tip: "Space left clear either side of each graph, so 2 graphs side by side have twice this between them. The two ends of the whole item get none, since the panel spaces its items. On a vertical panel this is the space either side of every graph."

	BackHead:
		label: Background
		tab: Themes/Outline
		control: heading

	transparent:
		label: Transparent
		tab: Themes/Outline
		control: checkbox
		path: graph.transparent
		default: false
		tip: "Let the panel show through behind the graph, in place of the Top and Bottom colors. This one goes for every theme, so picking another keeps it. The border and the hover line are still drawn."

	border_color:
		label: Border
		tab: Themes/Outline
		control: color
		path: graph.colors.border
		default: "#8b8b8b"
		group: theme

	back_top:
		label: Top
		tab: Themes/Outline
		control: color
		path: graph.colors.top
		default: "#313131"
		group: theme

	back_bottom:
		label: Bottom
		tab: Themes/Outline
		control: color
		path: graph.colors.bottom
		default: "#000000"
		group: theme

	hover_color:
		label: Hover line
		tab: Themes/Outline
		control: color
		path: graph.colors.hover
		default: "#000000"
		group: theme
		tip: "The line under the pointer."

## Theme names say nothing of color. Each graph has hues of its own in every
## theme, so the graphs are told apart side by side, except Terminal, Vintage
## and Frost, which give every graph one color. I/O wait and system stay red
## and orange in every theme, so trouble reads the same, and the battery's
## on battery and critical take those 2, as temperature's critical takes red.
## Fire's graphs each burn a flame of their own. Default is b23's colors, which
## break some of that where they were picked by hand. See design.md Theme.

groups:

	theme:
		chooser: theme
		noun: theme
		custom: Custom
		presets:
			default:
				label: Default
				cpu_mode: detailed
				cpu_low: "#205f40"
				cpu_medium: "#00ff80"
				cpu_high: "#c0ffe0"
				iowait: "#ff0000"
				system: "#fa72f0"
				user: "#00ff80"
				nice: "#205f40"
				mem_mode: detailed
				mem_low: "#408060"
				mem_medium: "#ffffa3"
				mem_high: "#ffffe0"
				mem_user: "#ffffa3"
				mem_buffers: "#804080"
				mem_cache: "#408060"
				net_mode: detailed
				net_low: "#2a5566"
				net_medium: "#6ad4ff"
				net_high: "#cff1ff"
				net_local: "#ffed00"
				net_sent: "#ff7777"
				net_received: "#6ad4ff"
				swap_mode: gradient
				swap_low: "#66461a"
				swap_medium: "#a45f00"
				swap_high: "#ffebcf"
				swap_used: "#a45f00"
				zswap_mode: gradient
				zswap_low: "#35663c"
				zswap_medium: "#4a8e54"
				zswap_high: "#cfffd6"
				zswap_used: "#4a8e54"
				load_mode: gradient
				load_low: "#553030"
				load_medium: "#924444"
				load_high: "#eb4a4a"
				load_used: "#924444"
				disk_mode: detailed
				disk_low: "#2b4866"
				disk_medium: "#6bb3ff"
				disk_high: "#cfe6ff"
				disk_write: "#c60000"
				disk_read: "#6bb3ff"
				temp_mode: gradient
				temp_low: "#4eb6bd"
				temp_medium: "#feff40"
				temp_high: "#ff0000"
				temp_normal: "#feff40"
				temp_critical: "#ff0000"
				battery_mode: detailed
				battery_low: "#483468"
				battery_medium: "#b080ff"
				battery_high: "#ece0ff"
				battery_charging: "#b080ff"
				battery_discharging: "#c46e43"
				battery_critical: "#ff0000"
				self_mode: detailed
				self_low: "#1a665e"
				self_medium: "#00ccb8"
				self_high: "#cffffa"
				self_used: "#00ccb8"
				border_color: "#8b8b8b"
				back_top: "#313131"
				back_bottom: "#000000"
				hover_color: "#000000"
				margin_tb: 2
				margin_lr: 2
			primary:
				label: Primary
				cpu_mode: detailed
				cpu_low: "#205f20"
				cpu_medium: "#00ff00"
				cpu_high: "#c0ffc0"
				iowait: "#ff0000"
				system: "#c64200"
				user: "#00ff00"
				nice: "#205f20"
				mem_mode: detailed
				mem_low: "#5f5f20"
				mem_medium: "#ffff00"
				mem_high: "#ffffc0"
				mem_user: "#ffff00"
				mem_buffers: "#604a20"
				mem_cache: "#5f5f20"
				net_mode: detailed
				net_low: "#3e205f"
				net_medium: "#9900ff"
				net_high: "#dec0ff"
				net_local: "#3e205f"
				net_sent: "#dec0ff"
				net_received: "#9900ff"
				swap_mode: detailed
				swap_low: "#20305f"
				swap_medium: "#0060ff"
				swap_high: "#c0d0ff"
				swap_used: "#0060ff"
				zswap_mode: detailed
				zswap_low: "#5f205f"
				zswap_medium: "#ff00ff"
				zswap_high: "#ffc0ff"
				zswap_used: "#ff00ff"
				load_mode: detailed
				load_low: "#660033"
				load_medium: "#ff0080"
				load_high: "#ffbfdf"
				load_used: "#ff0080"
				disk_mode: detailed
				disk_low: "#4b6600"
				disk_medium: "#bbff00"
				disk_high: "#eeffbf"
				disk_write: "#eeffbf"
				disk_read: "#bbff00"
				temp_mode: detailed
				temp_low: "#006644"
				temp_medium: "#00ffaa"
				temp_high: "#bfffea"
				temp_normal: "#00ffaa"
				temp_critical: "#ff0000"
				battery_mode: detailed
				battery_low: "#205f5f"
				battery_medium: "#00ffff"
				battery_high: "#c0ffff"
				battery_charging: "#00ffff"
				battery_discharging: "#c64200"
				battery_critical: "#ff0000"
				self_mode: detailed
				self_low: "#000066"
				self_medium: "#0000ff"
				self_high: "#bfbfff"
				self_used: "#0000ff"
				border_color: "#606060"
				back_top: "#2a2a2a"
				back_bottom: "#000000"
				hover_color: "#000000"
				margin_tb: 2
				margin_lr: 2
			pastel:
				label: Pastel
				cpu_mode: detailed
				cpu_low: "#6a7a8a"
				cpu_medium: "#a1c8f0"
				cpu_high: "#e0f0ff"
				iowait: "#ff6161"
				system: "#f09b71"
				user: "#a1c8f0"
				nice: "#6a7a8a"
				mem_mode: detailed
				mem_low: "#8a856a"
				mem_medium: "#f0e0a1"
				mem_high: "#fff8e0"
				mem_user: "#f0e0a1"
				mem_buffers: "#8a786a"
				mem_cache: "#8a856a"
				net_mode: detailed
				net_low: "#7e8a6a"
				net_medium: "#d3f0a1"
				net_high: "#f4ffe0"
				net_local: "#7e8a6a"
				net_sent: "#f4ffe0"
				net_received: "#d3f0a1"
				swap_mode: detailed
				swap_low: "#6a8a72"
				swap_medium: "#a1f0b8"
				swap_high: "#e0ffe8"
				swap_used: "#a1f0b8"
				zswap_mode: detailed
				zswap_low: "#8a6a75"
				zswap_medium: "#f0a1c3"
