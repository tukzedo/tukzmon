## tukzmon settings, read by the panel plugin and by tukzmon-settings.
##
## Compiled into both. The format is knobs', documented in knobs/src/lib.rs
## and SilkTerm's knobs/demo/demo.shcl. Colors default to a customized
## multiload-ng setup.
##
## slider_range is ours, not knobs'. It's how far a slider reaches, while
## range is what can be typed in the box beside it. shown_as: radio draws a
## dropdown as radio buttons, and shown_when: "id = key" shows a row only
## while that dropdown is on that key. Those 2 are ours too.
##
## Every color is in the theme group, and so is each graph's mode. A row's
## default is the Default theme's value, and config::tests holds the two to
## each other.

tabs: "Graph", "Themes", "Themes/CPU", "Themes/Memory", "Themes/Swap", "Themes/Background"

settings:

	SizeHead:
		label: Size
		tab: Graph
		control: heading

	width:
		label: Width px
		tab: Graph
		control: slider
		whole: true
		range: 16, 4096
		slider_range: 24, 1024
		scale: log
		path: graph.width
		default: 128
		detents: 64, 128, 256
		tip: "How wide each graph is in the panel, unless it has a width of its own under Graphs. Its height follows the panel."

	TimeHead:
		label: Time
		tab: Graph
		control: heading

	log_axis:
		label: Log time axis
		tab: Graph
		control: checkbox
		path: graph.log_axis
		default: true
		tip: "Squeeze older history to the left, so the last minute and the last day fit in one graph. Off gives a plain scrolling graph. A graph can pick its own under Graphs."

	log_curve:
		label: Log curve
		tab: Graph
		control: dropdown
		options: smooth, fixed_a, fixed_b
		option_labels: "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: graph.log_curve
		default: smooth
		gate: log_axis
		tip: "How older history is squeezed. Smooth log is one log curve across the whole run, with each pixel covering a little more time than the one to its right.\n\nLog A and Log B split the graph into 4 fixed divisions. From the right, they cover at most the last minute, the next 59 minutes, the next 23 hours, and everything older. Log A fills them early: the first after about half an hour of history, and all 3 within a week. Log B follows Smooth log until a division fills, after about a day and a half for the first and 4 months for all 3."

	sample_ms:
		label: Sample every ms
		tab: Graph
		control: slider
		whole: true
		range: 50, 60000
		slider_range: 100, 5000
		scale: log
		path: graph.sample_ms
		default: 500
		detents: 250, 500, 1000, 2000
		tip: "How often the graphs are read and redrawn."

	spikes:
		label: Spike emphasis %
		tab: Graph
		control: slider
		whole: true
		range: 0, 100
		path: graph.spikes
		default: 50
		gate: log_axis
		tip: "How far a squeezed column reaches from its average toward its peak. At 0% every column shows only its average, so short spikes in older history are smoothed away. At 100% a column covering a few seconds shows its full peak. The reach fades as a column covers more time, so on the far left spikes melt into the background even at 100%."

	hover_time:
		label: Hover shows
		tab: Graph
		control: dropdown
		options: ago, clock
		option_labels: "How long ago", "Date and time"
		path: graph.hover_time
		default: ago
		tip: "What the tip says about the time under the pointer. How long ago reads like 7 hrs ago. Date and time gives just the time for today, and the date too for anything older, in your locale's short format."

	LookHead:
		label: Frame
		tab: Graph
		control: heading

	border:
		label: Border px
		tab: Graph
		control: slider
		whole: true
		range: 0, 16
		slider_range: 0, 4
		path: graph.border
		default: 1

	GraphsHead:
		label: Graphs
		tab: Graph
		control: heading

	show_cpu:
		label: CPU graph
		tab: Graph
		control: checkbox
		path: cpu.show
		default: true
		tip: "Show CPU use: I/O wait, system, user and nice, from the bottom up. With every other graph off, it shows anyway, so the panel item never goes away."

	cpu_width:
		label: CPU width px
		tab: Graph
		control: number
		whole: true
		range: 0, 4096
		path: cpu.width
		default: 0
		gate: show_cpu
		tip: "How wide the CPU graph is, in the same pixels as Width. 0 uses Width."

	cpu_time:
		label: CPU time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "As set under Time", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: cpu.time
		default: same
		gate: show_cpu
		tip: "How the CPU graph spreads time across its width. As set under Time follows Log time axis and Log curve. Linear is a plain scrolling graph, and the log curves are the ones Log curve's tip describes."

	show_memory:
		label: Memory graph
		tab: Graph
		control: checkbox
		path: mem.show
		default: true
		tip: "Show memory use beside the CPU graph: what programs use, then buffers, then cache, from the bottom up. It's left out on a box where memory can't be read."

	mem_width:
		label: Memory width px
		tab: Graph
		control: number
		whole: true
		range: 0, 4096
		path: mem.width
		default: 0
		gate: show_memory
		tip: "How wide the memory graph is, in the same pixels as Width. 0 uses Width."

	mem_time:
		label: Memory time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "As set under Time", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: mem.time
		default: same
		gate: show_memory
		tip: "How the memory graph spreads time across its width. As set under Time follows Log time axis and Log curve. Linear is a plain scrolling graph, and the log curves are the ones Log curve's tip describes."

	show_swap:
		label: Swap graph
		tab: Graph
		control: checkbox
		path: swap.show
		default: false
		tip: "Show how much swap is in use. It's left out on a box with no swap."

	swap_width:
		label: Swap width px
		tab: Graph
		control: number
		whole: true
		range: 0, 4096
		path: swap.width
		default: 0
		gate: show_swap
		tip: "How wide the swap graph is, in the same pixels as Width. 0 uses Width."

	swap_time:
		label: Swap time axis
		tab: Graph
		control: dropdown
		options: same, linear, smooth, fixed_a, fixed_b
		option_labels: "As set under Time", "Linear", "Smooth log", "Log A, fixed divisions", "Log B, fixed divisions"
		path: swap.time
		default: same
		gate: show_swap
		tip: "How the swap graph spreads time across its width. As set under Time follows Log time axis and Log curve. Linear is a plain scrolling graph, and the log curves are the ones Log curve's tip describes."

	## The graph list's grippers write this, and it has no row of its own.
	graph_order:
		label: Order
		tab: Graph
		control: text
		path: graph.order
		default: "cpu mem swap"
		tip: "The graphs from left to right, or top to bottom on a vertical panel, by name: cpu for CPU, mem for memory and swap for swap. One left out goes at the end."

	HistoryHead:
		label: History
		tab: Graph
		control: heading

	keep_history:
		label: Keep across restarts
		tab: Graph
		control: checkbox
		path: history.keep
		default: true
		tip: "Save the graph's history and load it back when the panel starts, with the time it wasn't running left as a gap. Off stops saving, but what's already saved is kept for when it's turned back on."

	max_days:
		label: Max age in days
		tab: Graph
		control: number
		whole: true
		range: 1, 36500
		path: history.max_days
		default: 365
		gate: keep_history
		tip: "History older than this is dropped."

	theme:
		label: Name
		tab: Themes
		control: dropdown
		path: theme.name
		default: default
		tip: "A set of colors for every graph and its background. A color changed below is kept on top of the theme, and the theme's name gets a * after it. Save as keeps the colors as a theme of your own."

	cpu_mode:
		label: Colors
		tab: Themes/CPU
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: cpu.mode
		default: detailed
		group: theme
		tip: "Detailed gives each kind of CPU time a color of its own. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

	CpuHead:
		label: "CPU, from the bottom up"
		tab: Themes/CPU
		control: heading
		shown_when: "cpu_mode = detailed"

	iowait:
		label: I/O wait
		tab: Themes/CPU
		control: color
		path: cpu.colors.iowait
		default: "#ff0000"
		group: theme
		shown_when: "cpu_mode = detailed"

	system:
		label: System
		tab: Themes/CPU
		control: color
		path: cpu.colors.system
		default: "#c64200"
		group: theme
		shown_when: "cpu_mode = detailed"
		tip: "Kernel time, including interrupts."

	user:
		label: User
		tab: Themes/CPU
		control: color
		path: cpu.colors.user
		default: "#00ff80"
		group: theme
		shown_when: "cpu_mode = detailed"

	nice:
		label: Nice
		tab: Themes/CPU
		control: color
		path: cpu.colors.nice
		default: "#205f40"
		group: theme
		shown_when: "cpu_mode = detailed"
		tip: "Programs running at a lower priority."

	CpuGradHead:
		label: "CPU, by height"
		tab: Themes/CPU
		control: heading
		shown_when: "cpu_mode = gradient"

	cpu_low:
		label: Low
		tab: Themes/CPU
		control: color
		path: cpu.colors.low
		default: "#205f40"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color at the bottom of the graph. A column blends smoothly from Low through Medium to High as it climbs."

	cpu_medium:
		label: Medium
		tab: Themes/CPU
		control: color
		path: cpu.colors.medium
		default: "#00ff80"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color halfway up."

	cpu_high:
		label: High
		tab: Themes/CPU
		control: color
		path: cpu.colors.high
		default: "#c0ffe0"
		group: theme
		shown_when: "cpu_mode = gradient"
		tip: "The color at the top."

	mem_mode:
		label: Colors
		tab: Themes/Memory
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: mem.mode
		default: detailed
		group: theme
		tip: "Detailed gives programs, buffers and cache a color each. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

	MemHead:
		label: "Memory, from the bottom up"
		tab: Themes/Memory
		control: heading
		shown_when: "mem_mode = detailed"

	mem_user:
		label: Programs
		tab: Themes/Memory
		control: color
		path: mem.colors.user
		default: "#ffff80"
		group: theme
		shown_when: "mem_mode = detailed"
		tip: "Memory in use that isn't buffers or cache."

	mem_buffers:
		label: Buffers
		tab: Themes/Memory
		control: color
		path: mem.colors.buffers
		default: "#804080"
		group: theme
		shown_when: "mem_mode = detailed"

	mem_cache:
		label: Cache
		tab: Themes/Memory
		control: color
		path: mem.colors.cache
		default: "#408060"
		group: theme
		shown_when: "mem_mode = detailed"
		tip: "The page cache, which the kernel gives back when programs need it."

	MemGradHead:
		label: "Memory, by height"
		tab: Themes/Memory
		control: heading
		shown_when: "mem_mode = gradient"

	mem_low:
		label: Low
		tab: Themes/Memory
		control: color
		path: mem.colors.low
		default: "#408060"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color at the bottom of the graph. A column blends smoothly from Low through Medium to High as it climbs."

	mem_medium:
		label: Medium
		tab: Themes/Memory
		control: color
		path: mem.colors.medium
		default: "#ffff80"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color halfway up."

	mem_high:
		label: High
		tab: Themes/Memory
		control: color
		path: mem.colors.high
		default: "#ffffe0"
		group: theme
		shown_when: "mem_mode = gradient"
		tip: "The color at the top."

	swap_mode:
		label: Colors
		tab: Themes/Swap
		control: dropdown
		shown_as: radio
		options: detailed, gradient
		option_labels: "Detailed", "Gradient"
		path: swap.mode
		default: detailed
		group: theme
		tip: "Detailed draws swap in use in one color. Gradient colors the whole column by how high it reaches, from Low at the bottom through Medium to High at the top."

	swap_used:
		label: In use
		tab: Themes/Swap
		control: color
		path: swap.colors.used
		default: "#00ff80"
		group: theme
		shown_when: "swap_mode = detailed"

	SwapGradHead:
		label: "Swap, by height"
		tab: Themes/Swap
		control: heading
		shown_when: "swap_mode = gradient"

	swap_low:
		label: Low
		tab: Themes/Swap
		control: color
		path: swap.colors.low
		default: "#205f40"
		group: theme
		shown_when: "swap_mode = gradient"
		tip: "The color at the bottom of the graph. A column blends smoothly from Low through Medium to High as it climbs."

	swap_medium:
		label: Medium
		tab: Themes/Swap
		control: color
		path: swap.colors.medium
		default: "#00ff80"
		group: theme
		shown_when: "swap_mode = gradient"
		tip: "The color halfway up."

	swap_high:
		label: High
		tab: Themes/Swap
		control: color
		path: swap.colors.high
		default: "#c0ffe0"
		group: theme
		shown_when: "swap_mode = gradient"
		tip: "The color at the top."

	BackHead:
		label: Background
		tab: Themes/Background
		control: heading

	transparent:
		label: Transparent
		tab: Themes/Background
		control: checkbox
		path: graph.transparent
		default: false
		tip: "Let the panel show through behind the graph, in place of the Top and Bottom colors. This one goes for every theme, so picking another keeps it. The border and the hover line are still drawn."

	border_color:
		label: Border
		tab: Themes/Background
		control: color
		path: graph.colors.border
		default: "#408060"
		group: theme

	back_top:
		label: Top
		tab: Themes/Background
		control: color
		path: graph.colors.top
		default: "#2a543f"
		group: theme

	back_bottom:
		label: Bottom
		tab: Themes/Background
		control: color
		path: graph.colors.bottom
		default: "#000000"
		group: theme

	hover_color:
		label: Hover line
		tab: Themes/Background
		control: color
		path: graph.colors.hover
		default: "#000000"
		group: theme
		tip: "The line under the pointer."

## Themes are named for the color that leads, the user share, which sets the
## hue. Fire is the exception, named for its gradient: dim red, yellow-white,
## then light blue, like a hot flame. Nice, the border and the background are that hue muted. I/O wait and
## system stay red and orange in every theme, so trouble reads the same.
## Default's memory colors are multiload-ng's as they were. Buffers and cache
## are muted in the others, cache as nice and buffers a step round from it.

groups:

	theme:
		chooser: theme
		noun: theme
		custom: Custom
		presets:
			default:
				label: Default
				cpu_mode: detailed
				cpu_low: "#205f40"
				cpu_medium: "#00ff80"
				cpu_high: "#c0ffe0"
				iowait: "#ff0000"
				system: "#c64200"
				user: "#00ff80"
				nice: "#205f40"
				mem_mode: detailed
				mem_low: "#408060"
				mem_medium: "#ffff80"
				mem_high: "#ffffe0"
				mem_user: "#ffff80"
				mem_buffers: "#804080"
				mem_cache: "#408060"
				swap_mode: detailed
				swap_low: "#205f40"
				swap_medium: "#00ff80"
				swap_high: "#c0ffe0"
				swap_used: "#00ff80"
				border_color: "#408060"
				back_top: "#2a543f"
				back_bottom: "#000000"
				hover_color: "#000000"
			green_standard:
				label: Green standard
				cpu_mode: detailed
				cpu_low: "#205f20"
				cpu_medium: "#00ff00"
				cpu_high: "#c0ffc0"
				iowait: "#ff0000"
				system: "#c64200"
				user: "#00ff00"
				nice: "#205f20"
				mem_mode: detailed
				mem_low: "#205f20"
				mem_medium: "#00ff00"
				mem_high: "#c0ffc0"
				mem_user: "#00ff00"
				mem_buffers: "#2f6f5f"
				mem_cache: "#205f20"
				swap_mode: detailed
				swap_low: "#205f20"
				swap_medium: "#00ff00"
				swap_high: "#c0ffc0"
				swap_used: "#00ff00"
				border_color: "#408040"
				back_top: "#2a542a"
				back_bottom: "#000000"
				hover_color: "#000000"
			green_pastel:
				label: Green pastel
				cpu_mode: detailed
				cpu_low: "#6a8a6a"
				cpu_medium: "#a1f0a1"
				cpu_high: "#e0ffe0"
				iowait: "#ff6161"
				system: "#f09b71"
				user: "#a1f0a1"
				nice: "#6a8a6a"
				mem_mode: detailed
				mem_low: "#6a8a6a"
				mem_medium: "#a1f0a1"
				mem_high: "#e0ffe0"
				mem_user: "#a1f0a1"
				mem_buffers: "#7a9a92"
				mem_cache: "#6a8a6a"
				swap_mode: detailed
				swap_low: "#6a8a6a"
				swap_medium: "#a1f0a1"
				swap_high: "#e0ffe0"
				swap_used: "#a1f0a1"
				border_color: "#7fa17f"
				back_top: "#3a4a3a"
				back_bottom: "#0f140f"
				hover_color: "#000000"
			blue_standard:
				label: Blue standard
				cpu_mode: detailed
				cpu_low: "#20405f"
				cpu_medium: "#0080ff"
				cpu_high: "#c0e0ff"
				iowait: "#ff0000"
				system: "#c64200"
				user: "#0080ff"
				nice: "#20405f"
				mem_mode: detailed
				mem_low: "#20405f"
				mem_medium: "#0080ff"
				mem_high: "#c0e0ff"
				mem_user: "#0080ff"
				mem_buffers: "#40407f"
				mem_cache: "#20405f"
				swap_mode: detailed
				swap_low: "#20405f"
				swap_medium: "#0080ff"
				swap_high: "#c0e0ff"
				swap_used: "#0080ff"
				border_color: "#406080"
				back_top: "#2a3f54"
				back_bottom: "#000000"
				hover_color: "#000000"
			blue_pastel:
				label: Blue pastel
				cpu_mode: detailed
				cpu_low: "#6a7a8a"
				cpu_medium: "#a1c8f0"
				cpu_high: "#e0f0ff"
				iowait: "#ff6161"
				system: "#f09b71"
				user: "#a1c8f0"
				nice: "#6a7a8a"
				mem_mode: detailed
				mem_low: "#6a7a8a"
				mem_medium: "#a1c8f0"
				mem_high: "#e0f0ff"
				mem_user: "#a1c8f0"
				mem_buffers: "#8a8aa8"
				mem_cache: "#6a7a8a"
				swap_mode: detailed
				swap_low: "#6a7a8a"
				swap_medium: "#a1c8f0"
				swap_high: "#e0f0ff"
				swap_used: "#a1c8f0"
				border_color: "#7f90a1"
				back_top: "#3a424a"
				back_bottom: "#0f1214"
				hover_color: "#000000"
			fire:
				label: Fire
				cpu_mode: gradient
				cpu_low: "#8b1a00"
				cpu_medium: "#fff4c8"
				cpu_high: "#7fd4ff"
				iowait: "#ff0000"
				system: "#c64200"
				user: "#ffa000"
				nice: "#7f4a10"
				mem_mode: gradient
				mem_low: "#8b1a00"
				mem_medium: "#fff4c8"
				mem_high: "#7fd4ff"
				mem_user: "#ffa000"
				mem_buffers: "#7f2a10"
