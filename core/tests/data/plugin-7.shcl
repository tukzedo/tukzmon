## tukzmon settings. Only values changed from their defaults are listed.
##    Format   3
temp:
	time: smooth

swap:
	show: false

graph:
	order: [cpu, mem, net, disk, temp]

disk:
	drives: sda  # the nvme is too busy to read

# Kept by the program, so values can come back later.
kept:
	changes:
		theme:
			preset: default
			values:
				cpu:
					colors:
						medium: "#8ac751"
						high: "#5fbf37"
				mem:
					colors:
						cache: "#199d07"
				gpu:
					colors:
						busy: "#35a9fa"
				vram:
					colors:
						bottom: "#c89acd"
				net:
					colors:
						low: "#c3bbda"
				swap:
					mode: detailed
					colors:
						used: "#4ddae9"
						low: "#90c539"
						medium: "#0cada2"
						top: "#247806"
				zswap:
					mode: detailed
					colors:
						used: "#a15699"
				load:
					colors:
						border: "#03f124"
				disk:
					colors:
						border: "#0dfd9e"
				procs:
					colors:
						border: "#7f8e51"
				graph:
					margins:
						top_bottom: 22
					overrides:
						colors:
							border: "#dc8e73"
